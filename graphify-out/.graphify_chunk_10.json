{
  "nodes": [
    {"id": "releasing_md", "label": "RELEASING.md — Releasing NouPro", "file_type": "document", "source_file": "docs/RELEASING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "releasing_shipping_gap", "label": "The shipping gap", "file_type": "rationale", "source_file": "docs/RELEASING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Committed code did not reach the running app: 3 crashes stayed live for days after being fixed in the repo because the running build was never refreshed. The whole release procedure exists to close this gap."},
    {"id": "releasing_golden_rule", "label": "Golden rule: publish from clean committed code", "file_type": "concept", "source_file": "docs/RELEASING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never publish with half-finished work in the tree; stash WIP (git stash -u) before publishing so users never receive an untested partial state."},
    {"id": "releasing_preflight_gate", "label": "Preflight gate before publish", "file_type": "concept", "source_file": "docs/RELEASING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run `npm run preflight` before every eas update/build. It blocks on TS2304 'Cannot find name' typos (e.g. alignItems: center vs 'center', missing imports) — the one bug class that crashes the built Hermes app at launch but is invisible in dev."},
    {"id": "releasing_ota_vs_rebuild", "label": "OTA vs rebuild rule", "file_type": "concept", "source_file": "docs/RELEASING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OTA (eas update) ships JS/asset changes only (fast, no review). Rebuild (eas build) is required for native changes: new native dependency, iOS/Android permission, icon/splash, anything under the ios/android/plugins keys of app.config.ts, or any runtimeVersion bump."},
    {"id": "releasing_runtime_version_match", "label": "OTA reaches only matching runtimeVersion", "file_type": "concept", "source_file": "docs/RELEASING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An OTA only reaches installed builds whose runtimeVersion matches the update (currently 1.0.0, set in app.config.ts). Changing runtimeVersion forces a rebuild — existing installs will not receive the OTA."},
    {"id": "releasing_publish_channels", "label": "Three publish channels: dev / preview / production", "file_type": "concept", "source_file": "docs/RELEASING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Match the command to who needs the update: dev build (Metro reload) for yourself, preview channel (internal distribution) for testers, production channel (eas build/submit) for the store. ascAppId 6744329387 is wired in eas.json."},
    {"id": "releasing_sentry_watch", "label": "Watch Sentry after publish", "file_type": "concept", "source_file": "docs/RELEASING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After publishing, watch Sentry (org nou-innovations, project noupro). A previously-resolved crash reappearing is flagged as a regression — early warning that a stale build shipped or a bug was reintroduced."},

    {"id": "phase1_professional_profiles_tasks_design", "label": "Phase 1 spec: Professional Profiles + Tasks", "file_type": "document", "source_file": "docs/superpowers/specs/2026-04-11-phase1-professional-profiles-tasks-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "phase1_professional_profiles", "label": "Professional Profiles feature (LinkedIn-like)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-11-phase1-professional-profiles-tasks-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transforms Personal mode into professional networking: work experience, education, certifications, skills, plus extended User fields (headline, bio, industry, coverPhoto, profileSlug). WorkExperience is standalone/decoupled from BusinessMember."},
    {"id": "phase1_tasks_feature", "label": "Tasks feature (business operations)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-11-phase1-professional-profiles-tasks-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "General-purpose Task model scoped to Business (+optional Location), assignable to users, optionally linked to an order/delivery/invoice. Company endpoints gated by requireAuth + requireCompanyMember; /users/me/tasks is self-only."},
    {"id": "phase1_profile_completeness_algorithm", "label": "Profile completeness algorithm", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-04-11-phase1-professional-profiles-tasks-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weighted percentage across sections (photo 10, cover 5, headline 15, bio 10, industry 5, experience 20, education 15, skills 10, certification 10) returning percentage + completed[] + missing[] to nudge users to finish their profile."},
    {"id": "phase1_task_status_state_machine", "label": "Task status transitions", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-11-phase1-professional-profiles-tasks-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TODO -> IN_PROGRESS|CANCELLED; IN_PROGRESS -> COMPLETED|CANCELLED|TODO; COMPLETED -> TODO (reopen); CANCELLED -> TODO (reopen). Enforced server-side on the status-change endpoint."},
    {"id": "phase1_skill_master_table", "label": "Skill master table + UserSkill junction", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-11-phase1-professional-profiles-tasks-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skills are a reusable master table (unique name) joined to users via UserSkill with displayOrder. Skill creation is rate-limited; name max 100 chars, lowercased+trimmed for dedup; max 50 skills per user."},
    {"id": "phase1_implementation_order", "label": "Phase 1 build sequence", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-11-phase1-professional-profiles-tasks-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependency-ordered: (1) Prisma migration for 6 models + User fields, (2) profile CRUD endpoints, (3) tasks CRUD, (4) frontend types & services, (5) profile screens, (6) tasks screens, (7) navigation, (8) migrate work-experience screens to the new standalone endpoint."},
    {"id": "phase1_out_of_scope", "label": "Phase 1 out-of-scope (deferred to later phases)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-11-phase1-professional-profiles-tasks-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly excluded: endorsements/recommendations (Phase 4), people-you-may-know (Phase 4), company pages (Phase 2), job board (Phase 3), content feed (Phase 4), payment/billing (Phase 2), task push notifications (incremental). Cart/Orders/Deliveries screens already exist."},

    {"id": "analytics_variance_feature", "label": "Analytics + Variance deep-dive (Business+)", "file_type": "concept", "source_file": "src/features/analytics/analytics.service.ts", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Company-scoped deep-dive on top of the Business Home overview: revenue trend, orders mix, cash collection, top products/customers, monthly targets (BusinessTarget), period-over-period, and estimated margin/discount leakage. Backed by /companies/:id/analytics, /variance, /targets."},
    {"id": "analytics_business_plus_gating", "label": "Analytics gated to Business+ (30d = Enterprise)", "file_type": "rationale", "source_file": "src/features/analytics/screens/BusinessAnalyticsScreen.tsx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "analyticsType from usePermissions drives gating: 'none' shows an upgrade teaser (Free/Pro), 'full' unlocks the 30-day range (Enterprise). Reuses the existing analyticsType capability rather than adding a new one; enforced backend-side too."},

    {"id": "auth_registration_flow", "label": "Multi-step registration/onboarding flow", "file_type": "concept", "source_file": "src/features/auth/screens/CreateAccountScreen.tsx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CreateAccount -> Phone/EmailVerification (OTP) -> CreatePassword -> UploadProfilePicture -> ChoosePath (create business | join company | skip), and the business branch BusinessBasicInfo -> BusinessLocation -> BusinessHours -> UploadBusinessLogo. pendingAuth tokens are threaded through until login is finalized."},
    {"id": "auth_password_strength_policy", "label": "Password strength policy (5 rules)", "file_type": "rationale", "source_file": "src/features/auth/screens/CreatePasswordScreen.tsx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requires >=8 chars, uppercase, lowercase, number, and special char, with live per-rule feedback. The password is stored in registrationStore rather than navigation params for security, and a beforeRemove guard warns before discarding unsaved input."},
    {"id": "auth_email_enumeration_protection", "label": "Email-enumeration protection on password reset", "file_type": "rationale", "source_file": "src/features/auth/screens/ForgotPasswordScreen.tsx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ForgotPasswordScreen always shows the 'check your email' success state (except on a true network error) so an attacker cannot tell whether an account exists for a given address."},
    {"id": "auth_otp_dual_verification", "label": "Dual phone/email OTP verification", "file_type": "concept", "source_file": "src/features/auth/screens/EmailVerificationScreen.tsx", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "6-digit OTP verifiable by email (verifyEmailOTP) or SMS (sendPhoneOTP), with a 'send on message' fallback that replaces the screen with PhoneVerification. A dev-only mock code 123456 short-circuits verification when IS_DEV."},

    {"id": "env_build_profiles", "label": "Environment build profiles + feature flags", "file_type": "concept", "source_file": "src/config/env.ts", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EXPO_PUBLIC_APP_ENV selects dev/demo/prod (defaults to dev in __DEV__, prod otherwise). API_BASE_URL must be explicit for demo/prod (localhost fallback only in dev). Feature flags: PAYMENTS_ENABLED disabled in demo to prevent real transactions; ANALYTICS_ENABLED only in prod."}
